includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # Migrations are declarative schema definitions, not logic.
        -
            identifier: pixelforge.methodLength
            path: database/migrations/*

rules:
    - Tests\PHPStan\MethodLengthRule
